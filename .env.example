# Clinic 360 — environment
# Copy to .env and fill in. NEVER commit .env. No secret belongs in source control.

# ── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clinic360?schema=public"

# ── Clinic ───────────────────────────────────────────────────────────────────
CLINIC_TIMEZONE="Asia/Kolkata"

# ── SMS (OTP delivery) ───────────────────────────────────────────────────────
# Unset (or "console") uses the development transport, which prints the code to the
# server console and REFUSES TO RUN in production. Set a real provider before deploying.
# INTEGRATION POINT — see src/server/integrations/index.ts
# SMS_PROVIDER="msg91"
# SMS_PROVIDER_KEY=""
# SMS_SENDER_ID=""
# SMS_DLT_TEMPLATE_OTP=""     # DLT registration is mandatory for transactional SMS in India

# ── Push notifications ───────────────────────────────────────────────────────
# INTEGRATION POINT — FCM (Android/web) + APNs (iOS)
# PUSH_PROVIDER="fcm"
# FCM_SERVICE_ACCOUNT_JSON=""

# ── Email ────────────────────────────────────────────────────────────────────
# INTEGRATION POINT — SES / Resend / Postmark
# EMAIL_PROVIDER="resend"
# EMAIL_PROVIDER_KEY=""
# EMAIL_FROM="care@your-clinic.example"

# ── Object storage (medical documents) ───────────────────────────────────────
# Development writes to a local directory OUTSIDE public/, so files are never served
# directly. Production must use an S3-compatible bucket that is NOT public, with
# server-side encryption on and presigned URLs issued server-side only.
# INTEGRATION POINT
STORAGE_LOCAL_PATH=".storage"
# STORAGE_PROVIDER="s3"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── Payments ─────────────────────────────────────────────────────────────────
# Default is manual/at-the-counter settlement, which is a real clinic workflow rather
# than a simulated charge. Connect a UPI-capable gateway when ready.
# INTEGRATION POINT — Razorpay / Cashfree / PhonePe
# PAYMENT_PROVIDER="razorpay"
# PAYMENT_PROVIDER_KEY=""
# PAYMENT_PROVIDER_SECRET=""
# PAYMENT_WEBHOOK_SECRET=""

# ── AI assistant (Phase 4) ───────────────────────────────────────────────────
# The assistant never receives a database connection — see docs/02 TD-10.
# ANTHROPIC_API_KEY=""
